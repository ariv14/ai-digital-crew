rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;

      // Account deletion removes the user's own submissions first, then the
      // auth account (see deleteAccount in AuthProvider). Without this rule
      // the deleteDoc calls fail with permission-denied, the error is not
      // auth/requires-recent-login so it falls through to the generic
      // handler, and deleteUser is never reached — leaving both the projects
      // AND the account in place. Scoped to the owner's own documents.
      //
      // Pipeline-added projects carry submittedBy: "auto-discovery", which is
      // never a uid, so they can never match and stay undeletable from the
      // client. A document missing submittedBy fails evaluation, which denies.
      allow delete: if request.auth != null
                    && resource.data.submittedBy == request.auth.uid;

      match /snapshots/{snapshotId} {
        allow read: if true;
        allow write: if false; // Admin SDK only (pipeline writes)
      }
    }
    match /projectsCache/{docId} {
      allow read: if true;
      allow write: if false; // Only pipeline via Admin SDK
    }
    match /embeddingsCache/{docId} {
      allow read: if true;
      allow write: if false; // Only pipeline via Admin SDK
    }
    match /searchCache/{cacheId} {
      allow read: if true;
      allow write: if false; // only Cloud Functions (Admin SDK) can write
    }
    // ── Paid courses ────────────────────────────────────────────────
    // The full lessons of a paid course. A reader may fetch them only when
    // their entitlement lists the course. The site's static bundle holds the
    // outline and the free lessons, never these documents.
    match /courses/{courseId}/lessons/{lessonId} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
                  && courseId in get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.courses;
      allow write: if false; // scripts/course-admin.js via Admin SDK
    }
    // Which courses an account may read. Written by redeemAccessCode and
    // course-admin.js only: a client that could write here could grant itself access.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Deleting your own only gives access up, which account deletion needs.
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
    // Server-side only: codes, wrong-guess counters and tutor usage.
    match /accessCodes/{code} {
      allow read, write: if false;
    }
    match /redeemAttempts/{uid} {
      allow read, write: if false;
    }
    match /tutorUsage/{uid} {
      allow read, write: if false;
    }
    match /searchAnalytics/{docId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow read: if false; // analytics are write-only from client
    }
  }
}
